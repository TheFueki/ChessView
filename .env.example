POSTGRES_USER=chessview
POSTGRES_PASSWORD=chessview
POSTGRES_DB=chessview

DATABASE_URL=postgresql+asyncpg://chessview:chessview@localhost:5432/chessview
DOCKER_DATABASE_URL=postgresql+asyncpg://chessview:chessview@postgres:5432/chessview
STORAGE_DIR=storage
DOCKER_STORAGE_DIR=/app/storage

JWT_SECRET=change-me-for-shared-environments-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
OAUTHLIB_INSECURE_TRANSPORT=1
FIRST_ADMIN_EMAIL=
SEED_ADMIN_EMAIL=admin@chessview.app
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@chessview.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

VITE_SERVER_URL=http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_WS_PROXY_TARGET=ws://localhost:8000
